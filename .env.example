# CapSolver API key. Required only when CAPSOLVER_ENABLED=true.
# Get one at https://dashboard.capsolver.com
CAPSOLVER_KEY=CAP-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Turnstile solver switch. true (default) -> use CapSolver; false -> use the
# built-in Camoufox stealth browser (no captcha API key needed).
# The --solver capsolver|camoufox CLI flag overrides this.
CAPSOLVER_ENABLED=true

# Optional proxy used only when running with --proxy.
# Format: http://user:pass@host:port  (also supports socks5://)
PROXY_URL=

# Optional fixed password for created accounts. If empty, a random password
# (e.g. "Panther-Cobalt-4821") is generated for each account.
DEFAULT_PASSWORD=